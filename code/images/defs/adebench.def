Bootstrap: docker
From: python:3.11-slim

%post
    set -e
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99sandbox
    apt-get update && apt-get install -y tmux curl git patch && rm -rf /var/lib/apt/lists/*
    curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64" -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq
    pip install --no-cache-dir dbt-core==1.10.11 dbt-duckdb==1.9.3 duckdb==1.3.0 "gdown>=5.2.0" "pyyaml>=6.0" "uv>=0.7"
    mkdir -p /installed-agent /scripts /sage/solutions /sage /app /seeds /solutions /logs
