Bootstrap: docker
From: python:3.11-slim

%post
    set -e
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99sandbox
    apt-get update && apt-get install -y --no-install-recommends git curl && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir "dbt-duckdb>=1.7.0" "duckdb>=0.9.0" pandas
